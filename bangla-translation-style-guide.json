{
  "translation_system": {
    "name": "Universal Homeopathic Medical Translation Guide",
    "version": "1.0.0",
    "language": "bn-BD",
    "target_language": "Bangla",
    "domain": "Homeopathic Medical Literature",
    "scope": [
      "repertory",
      "materia_medica",
      "clinical_notes",
      "medical_terminology",
      "symptom_descriptions",
      "case_descriptions",
      "historical_homeopathic_texts",
      "therapeutic_notes",
      "pharmacological_descriptions",
      "anatomical_descriptions",
      "pathological_descriptions"
    ],
    "compatible_sources": [
      "Kent",
      "Boericke",
      "Clarke",
      "Hering",
      "Allen",
      "Boger",
      "Phatak",
      "Nash",
      "Lippe",
      "Farrington",
      "Knerr",
      "Bönninghausen",
      "Hahnemann",
      "other_homeopathic_sources"
    ]
  },

  "core_objective": {
    "primary_goal": "Preserve the exact meaning of the source while producing natural, medically understandable and terminology-consistent Bangla.",
    "translation_priority": [
      "semantic_accuracy",
      "clinical_accuracy",
      "anatomical_accuracy",
      "structural_accuracy",
      "terminology_consistency",
      "source_style_preservation",
      "natural_bangla",
      "readability"
    ],
    "golden_rule": "Never improve the Bangla by changing, weakening, strengthening, interpreting or inventing the medical meaning of the source."
  },

  "translation_modes": {
    "repertory": {
      "description": "Short rubric and sub-rubric translation.",
      "priority": [
        "clinical meaning",
        "rubric structure",
        "modality",
        "location",
        "condition",
        "brevity"
      ],
      "style": "Concise clinical Bangla",
      "allow_explanation": false
    },

    "materia_medica": {
      "description": "Translation of descriptive remedy literature.",
      "priority": [
        "meaning",
        "clinical nuance",
        "sentence relationship",
        "symptom characteristics",
        "natural Bangla"
      ],
      "style": "Natural medical Bangla",
      "allow_explanation": false
    },

    "clinical_description": {
      "description": "Translation of clinical observations and case descriptions.",
      "priority": [
        "clinical meaning",
        "temporal relationship",
        "causation",
        "symptom characteristics",
        "natural Bangla"
      ],
      "style": "Professional medical Bangla",
      "allow_explanation": false
    },

    "terminology": {
      "description": "Translation of isolated medical terminology.",
      "priority": [
        "standard terminology",
        "anatomical accuracy",
        "medical accuracy",
        "consistency"
      ],
      "style": "Canonical terminology",
      "allow_explanation": false
    },

    "historical_text": {
      "description": "Translation of old or archaic homeopathic literature.",
      "priority": [
        "historical meaning",
        "source terminology",
        "clinical meaning",
        "readability"
      ],
      "style": "Historically faithful modern Bangla",
      "allow_explanation": false
    }
  },

  "source_preservation": {
    "rules": [
      "Original English source must remain unchanged in the source field.",
      "Translation must never modify the original source.",
      "Historical spelling must not be silently modernized.",
      "Old medical terminology must not be replaced with modern terminology if doing so changes source identity.",
      "Abbreviations must be interpreted only when their meaning is sufficiently certain.",
      "Unknown or ambiguous terminology must be flagged instead of guessed."
    ]
  },

  "semantic_rules": {
    "preserve": [
      "body_part",
      "anatomical_location",
      "laterality",
      "direction",
      "time",
      "frequency",
      "duration",
      "sequence",
      "intensity",
      "quality",
      "sensation",
      "causation",
      "modality",
      "aggravation",
      "amelioration",
      "condition",
      "negation",
      "comparison",
      "movement",
      "position",
      "relationship"
    ],

    "never_remove": [
      "not",
      "never",
      "does not",
      "fails to",
      "only",
      "even",
      "before",
      "after",
      "during",
      "while",
      "until",
      "from",
      "toward",
      "through",
      "left",
      "right",
      "both",
      "slight",
      "violent",
      "severe"
    ],

    "never_add": [
      "diagnosis",
      "treatment",
      "dosage",
      "remedy",
      "clinical advice",
      "homeopathic interpretation",
      "causal explanation",
      "modern medical explanation",
      "unsupported anatomical interpretation"
    ]
  },

  "translation_method": {
    "steps": [
      {
        "step": 1,
        "name": "Identify source type",
        "action": "Determine whether the text is a rubric, sub-rubric, materia medica prose, clinical description or terminology."
      },
      {
        "step": 2,
        "name": "Parse grammar",
        "action": "Identify subject, object, verb, modifier, preposition, condition and relationship."
      },
      {
        "step": 3,
        "name": "Identify clinical meaning",
        "action": "Determine the medical meaning before translating."
      },
      {
        "step": 4,
        "name": "Resolve terminology",
        "action": "Use the canonical terminology dictionary."
      },
      {
        "step": 5,
        "name": "Preserve structure",
        "action": "Preserve placeholders, hierarchy, conditions and modifiers."
      },
      {
        "step": 6,
        "name": "Generate Bangla",
        "action": "Produce concise and natural Bangla."
      },
      {
        "step": 7,
        "name": "Validate",
        "action": "Compare the Bangla against the original for semantic loss or distortion."
      }
    ]
  },

  "canonical_abbreviations": {
    "agg.": {
      "meaning": "aggravation",
      "bangla": "বৃদ্ধি"
    },
    "amel.": {
      "meaning": "amelioration",
      "bangla": "উপশম"
    },
    "aversion": {
      "bangla": "অনাগ্রহ / বিরাগ"
    },
    "desire": {
      "bangla": "ইচ্ছা / আকাঙ্ক্ষা"
    },
    "complaint": {
      "bangla": "অভিযোগ / উপসর্গ"
    },
    "thro'": {
      "bangla": "মধ্য দিয়ে"
    }
  },

  "aggravation_rules": {
    "canonical_term": "বৃদ্ধি",
    "patterns": {
      "X agg.": "X-এ বৃদ্ধি",
      "X aggravates": "X-এ বৃদ্ধি",
      "aggravated by X": "X-এ বৃদ্ধি",
      "worse from X": "X-এ বৃদ্ধি",
      "worse when X": "X হলে বৃদ্ধি"
    },
    "do_not_use_as_default": [
      "অবনতি",
      "খারাপ",
      "আরও খারাপ"
    ]
  },

  "amelioration_rules": {
    "canonical_term": "উপশম",
    "patterns": {
      "X amel.": "X-এ উপশম",
      "ameliorated by X": "X-এ উপশম",
      "better from X": "X-এ উপশম",
      "better when X": "X হলে উপশম"
    }
  },

  "placeholder_policy": {
    "symbol": "-",
    "purpose": "Incomplete rubric or phrase-এর grammatical placeholder.",
    "preserve_exactly": true,
    "rules": {
      "of": "-এর",
      "from": "-থেকে",
      "in": "-এ",
      "on": "-এ / -এর উপর",
      "to": "-এ / -দিকে",
      "into": "-এর ভিতরে / -এ",
      "through": "-এর মধ্য দিয়ে",
      "over": "-এর উপর",
      "under": "-এর নিচে",
      "around": "-এর চারপাশে"
    },
    "examples": {
      "roots of": "-এর গোড়া",
      "running in": "-এ বয়ে যাওয়া",
      "rising from": "-থেকে উঠে আসা",
      "sensation of": "-এর অনুভূতি"
    }
  },

