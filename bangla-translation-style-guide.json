  "anatomical_safety": {
    "rules": [
      "Do not infer an anatomical structure when the source is ambiguous.",
      "Do not replace a specific structure with a broader region.",
      "Do not translate a historical anatomical term using an unrelated modern structure.",
      "If a term has multiple possible anatomical meanings, flag it for review."
    ],
    "example": {
      "source": "cord",
      "action": "Do not automatically translate as spinal cord.",
      "status": "REVIEW"
    }
  },

